---
interface Props {
  name: 'pulse' | 'orbit' | 'shield' | 'bolt' | 'layers' | 'grid';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

const paths: Record<Props['name'], string> = {
  pulse: 'M3 12h4l2.5-7 4 14L16 12h5',
  orbit: 'M12 5a7 7 0 1 0 7 7 M12 3v3 M18.5 6.5 16 9 M4 12a8 8 0 0 1 8-8',
  shield: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z',
  bolt: 'M13 3 5 14h5l-1 7 8-11h-5l1-7z',
  layers: 'M12 3l8 4.5-8 4.5-8-4.5L12 3z M4 12l8 4.5 8-4.5 M4 16.5l8 4.5 8-4.5',
  grid: 'M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={paths[name]} />
</svg>
