---
export const prerender = true;

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';

const reader = createReader(process.cwd(), keystaticConfig);
const home = (await reader.singletons.home.read()) ?? {
  announcement: 'START GROWING WITH VANTAGE TODAY!',
  announcementCta: 'GET STARTED',
  badge: 'Astro Template',
  heading: 'Your ally in efficient',
  headingMuted: '& intelligent brand.',
  description:
    'Discover a new standard of innovation and design, where technology and creativity work hand in hand to elevate your brand.',
  ctaLabel: 'Buy Template',
  secondaryCtaLabel: 'Explore benefits',
  testimonialQuote: 'With Vantage™ we’ve really made a mark in the market.',
  testimonialName: 'Jordan Avery',
  testimonialTitle: 'Founder of Northline Goods',
};
---

<Layout title="Vantage™ — Your ally in efficient & intelligent brand">
  <AnnouncementBar text={home.announcement} cta={home.announcementCta} />
  <Header ctaLabel={home.ctaLabel} />
  <Hero
    badge={home.badge}
    heading={home.heading}
    headingMuted={home.headingMuted}
    description={home.description}
    ctaLabel={home.ctaLabel}
    secondaryCtaLabel={home.secondaryCtaLabel}
    testimonialQuote={home.testimonialQuote}
    testimonialName={home.testimonialName}
    testimonialTitle={home.testimonialTitle}
  />
</Layout>
