---
import TreeScene from './TreeScene.astro';

interface Props {
  badge: string;
  heading: string;
  headingMuted: string;
  description: string;
  ctaLabel: string;
  secondaryCtaLabel: string;
  testimonialQuote: string;
  testimonialName: string;
  testimonialTitle: string;
}

const {
  badge,
  heading,
  headingMuted,
  description,
  ctaLabel,
  secondaryCtaLabel,
  testimonialQuote,
  testimonialName,
  testimonialTitle,
} = Astro.props;

const otherPages = [
  { label: 'Portfolio home', href: '../index.html' },
  { label: 'Asme landing', href: '../asme-landing.html' },
  { label: 'Coffee menu', href: '../coffee-menu.html' },
  { label: 'Meridian landing', href: '../meridian-landing.html' },
];
---

<section class="relative mx-auto mt-4 h-[640px] w-full max-w-6xl overflow-hidden rounded-[2rem]">
  <TreeScene />

  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-full bg-gradient-to-r from-black/45 via-black/15 to-transparent md:w-2/3"
    aria-hidden="true"
  >
  </div>

  <div class="absolute inset-x-6 top-8 max-w-md md:top-10">
    <span class="inline-flex items-center gap-2 rounded-full border border-white/40 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
      {badge}
    </span>
    <h1 class="mt-4 text-4xl font-bold leading-[1.05] text-white md:text-5xl">
      {heading}
      <span class="block text-white/60">{headingMuted}</span>
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-white/80">
      {description}
    </p>
    <div class="mt-6 flex items-center gap-5">
      <a
        href="#buy"
        class="flex items-center gap-2 rounded-full bg-lime px-5 py-3 text-sm font-semibold text-neutral-900 transition hover:bg-lime-dark"
      >
        {ctaLabel}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href="#benefits" class="flex items-center gap-1 text-sm font-semibold text-lime">
        {secondaryCtaLabel}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>

  <div class="absolute inset-x-4 bottom-4 flex flex-col items-start gap-3 md:inset-x-6 md:bottom-6 md:flex-row md:items-end md:justify-between">
    <details class="order-2 md:order-1">
      <summary class="flex w-fit list-none items-center gap-2 rounded-full bg-neutral-900/80 px-4 py-2 text-xs font-semibold text-white backdrop-blur [&::-webkit-details-marker]:hidden">
        Explore all pages
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
          <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <ul class="mt-2 w-48 rounded-2xl bg-white p-2 text-sm text-neutral-700 shadow-lg">
        {otherPages.map((page) => (
          <li>
            <a href={page.href} class="block rounded-xl px-3 py-2 hover:bg-neutral-100">{page.label}</a>
          </li>
        ))}
      </ul>
    </details>

    <div class="order-1 w-64 max-w-full rounded-2xl bg-white/95 p-5 backdrop-blur md:order-2">
      <div class="flex gap-0.5 text-lime" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z" />
          </svg>
        ))}
      </div>
      <p class="mt-3 text-sm font-medium leading-relaxed text-neutral-800">
        “{testimonialQuote}”
      </p>
      <div class="mt-3 flex items-center gap-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-neutral-900 text-xs font-semibold text-white">
          {testimonialName.split(' ').map((part) => part[0]).join('')}
        </span>
        <div class="text-xs">
          <p class="font-semibold text-neutral-900">{testimonialName}</p>
          <p class="text-neutral-500">{testimonialTitle}</p>
        </div>
      </div>
    </div>
  </div>
</section>
