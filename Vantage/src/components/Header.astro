---
const navLinks = [
  { label: 'Our Story', href: '#story' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Contact', href: '#contact' },
  { label: 'Stories', href: '#stories' },
  { label: 'FAQ', href: '#faq' },
];

interface Props {
  ctaLabel: string;
}

const { ctaLabel } = Astro.props;
---

<header class="mx-auto mt-4 flex w-full max-w-6xl items-center justify-between rounded-full bg-white px-4 py-2.5 shadow-sm">
  <a href={import.meta.env.BASE_URL} class="pl-2 text-lg font-bold tracking-tight text-neutral-900">
    Vantage<span class="align-super text-[0.6em]">™</span>
  </a>

  <nav class="hidden items-center gap-7 text-sm font-medium text-neutral-700 md:flex">
    <button type="button" class="flex items-center gap-1 hover:text-neutral-900">
      Menu
      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    {navLinks.map((link) => (
      <a href={link.href} class="hover:text-neutral-900">{link.label}</a>
    ))}
  </nav>

  <div class="flex items-center gap-3">
    <button type="button" aria-label="Cart" class="relative flex h-9 w-9 items-center justify-center rounded-full hover:bg-neutral-100">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h7.2a2 2 0 0 0 2-1.6L20 8H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="9" cy="21" r="1.4" fill="currentColor" />
        <circle cx="18" cy="21" r="1.4" fill="currentColor" />
      </svg>
      <span class="absolute -top-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-neutral-900 text-[10px] font-semibold text-white">2</span>
    </button>
    <a href="#buy" class="rounded-full bg-lime px-4 py-2 text-sm font-semibold text-neutral-900 transition hover:bg-lime-dark">
      {ctaLabel}
    </a>
  </div>
</header>
