---
import AnimatedBackground from './AnimatedBackground.astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  headingTop: string;
  headingBottom: string;
  subheading: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  statLabel: string;
  statValue: string;
  statCaption: string;
}

const {
  eyebrow,
  headingTop,
  headingBottom,
  subheading,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  statLabel,
  statValue,
  statCaption,
} = Astro.props as Props;

const miniFeatures = [
  { icon: 'pulse' as const, label: 'Wgląd w czasie rzeczywistym' },
  { icon: 'shield' as const, label: 'Bezpieczeństwo enterprise' },
  { icon: 'layers' as const, label: 'Architektura modularna' },
];
---

<section class="relative isolate overflow-hidden bg-void-950 pb-24 pt-16 sm:pb-32">
  <AnimatedBackground />

  <div class="relative z-10 mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:px-8">
    <!-- left: copy -->
    <div>
      <div
        class="reveal inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.15em] text-vantage-400 backdrop-blur"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-vantage-glow animate-pulse-slow"></span>
        {eyebrow}
      </div>

      <h1 class="reveal mt-6 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-balance sm:text-5xl lg:text-6xl" data-delay="90">
        <span class="text-white">{headingTop}</span>
        <br />
        <span class="text-white/40">{headingBottom}</span>
      </h1>

      <p class="reveal mt-6 max-w-xl text-balance text-base text-white/60 sm:text-lg" data-delay="180">
        {subheading}
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-4" data-delay="270">
        <a
          href={primaryCtaHref}
          class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-vantage-500 to-vantage-glow px-6 py-3 text-sm font-semibold text-void-950 shadow-[0_0_30px_-8px_rgba(79,195,255,0.7)] transition-transform hover:scale-[1.03]"
        >
          {primaryCtaLabel}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href={secondaryCtaHref} class="group inline-flex items-center gap-2 text-sm font-semibold text-white/80 hover:text-white">
          {secondaryCtaLabel}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <div class="reveal mt-14 flex flex-wrap gap-x-8 gap-y-4 border-t border-white/10 pt-8" data-delay="360">
        {
          miniFeatures.map((item) => (
            <div class="flex items-center gap-2.5 text-sm text-white/50">
              <Icon name={item.icon} class="h-4 w-4 text-vantage-400" />
              {item.label}
            </div>
          ))
        }
      </div>
    </div>

    <!-- right: visual panel -->
    <div class="reveal relative" data-delay="150">
      <div class="relative mx-auto max-w-md animate-float">
        <div class="absolute -inset-4 rounded-[2rem] bg-vantage-500/10 blur-2xl"></div>

        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] p-6 backdrop-blur-xl shadow-2xl">
          <div class="flex items-center justify-between text-xs text-white/40">
            <span class="font-mono">vantage://control-panel</span>
            <div class="flex gap-1.5">
              <span class="h-2 w-2 rounded-full bg-white/20"></span>
              <span class="h-2 w-2 rounded-full bg-white/20"></span>
              <span class="h-2 w-2 rounded-full bg-vantage-400"></span>
            </div>
          </div>

          <div class="mt-6 flex items-end gap-2" style="height: 120px;">
            {
              [38, 62, 45, 80, 58, 95, 70].map((h, i) => (
                <div
                  class="flex-1 rounded-t-md bg-gradient-to-t from-vantage-600/70 to-vantage-glow/70"
                  style={`height: ${h}%; animation: fade-up 1s cubic-bezier(0.16,1,0.3,1) forwards; animation-delay: ${i * 90 + 200}ms; opacity: 0;`}
                />
              ))
            }
          </div>

          <div class="mt-6 grid grid-cols-3 gap-3 text-center">
            <div class="rounded-xl border border-white/10 bg-white/5 py-3">
              <p class="font-display text-lg font-semibold text-white">128k</p>
              <p class="mt-1 text-[11px] text-white/40">żądań / min</p>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/5 py-3">
              <p class="font-display text-lg font-semibold text-white">42ms</p>
              <p class="mt-1 text-[11px] text-white/40">opóźnienie</p>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/5 py-3">
              <p class="font-display text-lg font-semibold text-white">40+</p>
              <p class="mt-1 text-[11px] text-white/40">regionów</p>
            </div>
          </div>
        </div>

        <div
          class="absolute -bottom-20 -left-6 w-64 rounded-2xl border border-white/10 bg-void-900/90 p-4 shadow-2xl backdrop-blur-xl sm:-left-10"
        >
          <div class="flex items-center gap-3">
            <span class="relative flex h-9 w-9 items-center justify-center rounded-full bg-vantage-glow/15">
              <span class="absolute h-full w-full animate-ping rounded-full bg-vantage-glow/20"></span>
              <Icon name="pulse" class="h-4 w-4 text-vantage-glow" />
            </span>
            <div>
              <p class="text-[11px] uppercase tracking-wide text-white/40">{statLabel}</p>
              <p class="font-display text-lg font-semibold text-white">{statValue}</p>
            </div>
          </div>
          <p class="mt-2 text-[11px] text-white/40">{statCaption}</p>
        </div>
      </div>
    </div>
  </div>
</section>
