---
import FeatureCard from './FeatureCard.astro';

interface FeatureItem {
  title: string;
  description: string;
  icon: 'pulse' | 'shield' | 'layers' | 'bolt' | 'globe' | 'terminal';
}

interface Props {
  features: FeatureItem[];
}

const { features } = Astro.props;
---

<section id="features" class="relative border-t border-white/5 bg-void-950 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-vantage-400">Możliwości</p>
      <h2 class="reveal mt-3 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl" data-delay="80">
        Wszystko, czego potrzebuje nowoczesny zespół produktowy
      </h2>
      <p class="reveal mt-4 text-white/55" data-delay="160">
        Vantage zastępuje rozproszony stos narzędzi jedną, spójną platformą — od monitoringu po wdrożenia.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature, i) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            icon={feature.icon}
            delay={(i % 3) * 90}
          />
        ))
      }
    </div>
  </div>
</section>
