---
---

<div class="pointer-events-none absolute inset-0 overflow-hidden">
  <!-- static gradient glows -->
  <div
    class="absolute -top-40 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-vantage-600/20 blur-[140px]"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 h-[420px] w-[420px] rounded-full bg-vantage-glow/10 blur-[130px]"
  >
  </div>

  <!-- animated grid -->
  <div
    class="absolute inset-0 animate-grid-pan opacity-[0.18]"
    style="background-image: linear-gradient(to right, rgba(125,214,255,0.35) 1px, transparent 1px), linear-gradient(to bottom, rgba(125,214,255,0.35) 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>

  <!-- vignette so grid fades toward edges -->
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at center, transparent 30%, #050608 85%);"
  >
  </div>

  <div id="vantage-particles" class="absolute inset-0 h-full w-full opacity-70"></div>
</div>

<script>
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  const container = document.getElementById('vantage-particles');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (container && !prefersReducedMotion) {
    await loadSlim(tsParticles);

    await tsParticles.load({
      id: 'vantage-particles',
      options: {
        fullScreen: { enable: false },
        background: { color: { value: 'transparent' } },
        fpsLimit: 60,
        detectRetina: true,
        pauseOnBlur: true,
        pauseOnOutsideViewport: true,
        particles: {
          number: { value: 46, density: { enable: true, width: 1440, height: 900 } },
          color: { value: '#8ef5d0' },
          shape: { type: 'circle' },
          opacity: { value: 0.55 },
          size: { value: 1.6 },
          links: {
            enable: true,
            distance: 140,
            color: '#7dd6ff',
            opacity: 0.16,
            width: 1,
          },
          move: {
            enable: true,
            speed: 0.4,
            direction: 'none',
            random: true,
            straight: false,
            outModes: { default: 'bounce' },
          },
        },
        interactivity: {
          events: { onHover: { enable: false }, onClick: { enable: false } },
        },
      },
    });
  }
</script>
