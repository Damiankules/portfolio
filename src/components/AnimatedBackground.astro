---
---

<div class="pointer-events-none absolute inset-0 overflow-hidden">
  <!-- static gradient glows -->
  <div
    class="absolute -top-40 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-vantage-600/20 blur-[140px]"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 h-[420px] w-[420px] rounded-full bg-vantage-glow/10 blur-[130px]"
  >
  </div>

  <!-- animated grid -->
  <div
    class="absolute inset-0 animate-grid-pan opacity-[0.18]"
    style="background-image: linear-gradient(to right, rgba(125,214,255,0.35) 1px, transparent 1px), linear-gradient(to bottom, rgba(125,214,255,0.35) 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>

  <!-- vignette so grid fades toward edges -->
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at center, transparent 30%, #050608 85%);"
  >
  </div>

  <canvas id="vantage-network" class="absolute inset-0 h-full w-full opacity-70"></canvas>
</div>

<script>
  const canvas = document.getElementById('vantage-network') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (ctx && !prefersReducedMotion) {
      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let visible = true;

      type Node = { x: number; y: number; vx: number; vy: number };
      let nodes: Node[] = [];

      const NODE_COUNT = 46;
      const LINK_DISTANCE = 140;

      function resize() {
        if (!canvas) return;
        width = canvas.clientWidth;
        height = canvas.clientHeight;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function seed() {
        nodes = Array.from({ length: NODE_COUNT }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.25,
          vy: (Math.random() - 0.5) * 0.25,
        }));
      }

      function step() {
        if (!ctx || !visible) {
          requestAnimationFrame(step);
          return;
        }
        ctx.clearRect(0, 0, width, height);

        for (const node of nodes) {
          node.x += node.vx;
          node.y += node.vy;
          if (node.x < 0 || node.x > width) node.vx *= -1;
          if (node.y < 0 || node.y > height) node.vy *= -1;
        }

        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i];
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < LINK_DISTANCE) {
              ctx.strokeStyle = `rgba(125, 214, 255, ${0.14 * (1 - dist / LINK_DISTANCE)})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }

        for (const node of nodes) {
          ctx.fillStyle = 'rgba(142, 245, 208, 0.55)';
          ctx.beginPath();
          ctx.arc(node.x, node.y, 1.6, 0, Math.PI * 2);
          ctx.fill();
        }

        requestAnimationFrame(step);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) visible = entry.isIntersecting;
        },
        { threshold: 0 }
      );
      io.observe(canvas);

      resize();
      seed();
      requestAnimationFrame(step);

      window.addEventListener('resize', () => {
        resize();
        seed();
      });
    }
  }
</script>
